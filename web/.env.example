# Copy this file to .env (or .env.local) and adjust for your environment.
# All variables are optional; see src/lib/config.ts for the local-dev fallback values.

# Backend REST API base URL (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Backend WebSocket base URL (use wss:// in production, behind TLS).
VITE_WS_BASE_URL=ws://localhost:8000

# Where the "Download Android APK" button links to. Point this at a hosted release APK
# (e.g. a GitHub Releases asset URL, or a file served by your backend/CDN).
VITE_APK_URL=/watchwire.apk
