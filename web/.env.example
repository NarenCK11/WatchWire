# Copy this file to .env (or .env.local) if you need to override anything.
# Every variable is OPTIONAL -- the defaults are derived at runtime from the host that
# served the page, so opening the app at http://localhost:5173 or at
# http://192.168.1.6:5173 from a phone both work with no configuration.
# See src/lib/config.ts.

# Backend REST base URL. Default: same host as the page, port 8000.
# VITE_API_BASE_URL=http://192.168.1.6:8000

# Backend WebSocket base URL. Default: same host as the page, port 8000 (wss:// if the
# page itself is served over HTTPS).
# VITE_WS_BASE_URL=ws://192.168.1.6:8000

# Target of the "Download Android APK" button.
# Default: <VITE_API_BASE_URL>/download/apk, i.e. the APK the backend serves from dist/.
# Override to host the APK elsewhere, e.g. a GitHub Release asset.
# VITE_APK_URL=https://github.com/NarenCK11/WatchWire/releases/latest/download/watchwire.apk
