# Copy this file to .env and adjust for your environment.
# All variables are prefixed with WATCHWIRE_ and are optional (sensible defaults exist for
# local development). See app/config.py for the full list.

# Login credentials for the web app (single admin account for this MVP).
WATCHWIRE_ADMIN_USERNAME=admin
WATCHWIRE_ADMIN_PASSWORD=changeme123

# MUST be set to a long, random, fixed value in production so JWTs survive restarts and
# cannot be forged. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WATCHWIRE_JWT_SECRET=

# Comma-separated list of allowed origins for the web app (CORS).
WATCHWIRE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pairing code lifetime, in seconds.
WATCHWIRE_CODE_TTL_SECONDS=300
